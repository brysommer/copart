TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
# Primary vision model (quality > cost)
OPENAI_MODEL=gpt-4o
# Optional cheaper triage; defaults to OPENAI_MODEL
# OPENAI_TRIAGE_MODEL=gpt-4o-mini
# Used once if primary model fails to read VIN
OPENAI_VIN_RETRY_MODEL=gpt-4o
# FX for dual $ / грн display when model returns only one currency
UAH_PER_USD=41
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copart?schema=public
STORAGE_DIR=./storage

# Cookie string from browser (DevTools → Network → request to copart.com → Request Headers → Cookie)
# Needed to bypass Incapsula when downloading lot image ZIPs.
COPART_COOKIE=

# Optional: match your browser UA if downloads still fail
# COPART_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36

# VinReport Carfax PDF API — https://vinreport.shop/api/docs/v3-pdf.html
VINREPORT_API_KEY=
VINREPORT_USER_ID=
# VINREPORT_BASE_URL=https://vinreport.shop
# VINREPORT_MAX_ATTEMPTS=4

# Optional window sticker URL template with {vin}
# WINDOW_STICKER_URL_TEMPLATE=https://www.chrysler.com/hostd/windowsticker/getWindowStickerPdf.do?vin={vin}
