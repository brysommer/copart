TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
# Primary vision model (quality > cost)
OPENAI_MODEL=gpt-4o
# Optional cheaper triage; defaults to OPENAI_MODEL
# OPENAI_TRIAGE_MODEL=gpt-4o-mini
# Used once if primary model fails to read VIN
OPENAI_VIN_RETRY_MODEL=gpt-4o
# FX for dual $ / грн display when model returns only one currency
UAH_PER_USD=41
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copart?schema=public
STORAGE_DIR=./storage

# Cookie string from browser (DevTools → Network → lotImages/download → Request Headers → Cookie)
# Needed to bypass Incapsula when downloading lot image ZIPs. Prefer same PC/IP as the bot.
COPART_COOKIE=

# Optional: match your browser UA (same request as Cookie)
# COPART_USER_AGENT=Mozilla/5.0 (Linux; Android 15; Pixel 9) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Mobile Safari/537.36

# Optional: Request Headers → x-xsrf-token (also auto-read from Cookie XSRF-TOKEN if present)
# COPART_XSRF_TOKEN=

# IAAI — Cookie from DevTools → DownloadImages (optional bootstrap for Chrome profile)
IAAI_COOKIE=
# IAAI_USER_AGENT=Mozilla/5.0 (Linux; Android 15; Pixel 9) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Mobile Safari/537.36

# Download lot ZIPs via desktop Google Chrome (Playwright). Default ON on Windows.
AUCTION_USE_BROWSER=1
# 0 = visible Chrome (краще для першого проходження Incapsula), 1 = headless
BROWSER_HEADLESS=0
# Optional dedicated Chrome profile dir (default: %LOCALAPPDATA%\copart-bot-chrome)
# BROWSER_USER_DATA_DIR=

# VinReport Carfax PDF API — https://vinreport.shop/api/docs/v3-pdf.html
VINREPORT_API_KEY=
VINREPORT_USER_ID=
# VINREPORT_BASE_URL=https://vinreport.shop
# VINREPORT_MAX_ATTEMPTS=4

# Optional window sticker URL template with {vin}
# WINDOW_STICKER_URL_TEMPLATE=https://www.chrysler.com/hostd/windowsticker/getWindowStickerPdf.do?vin={vin}

# --- LinkedIn autopilot (low-volume; human approve posts) ---
# LINKEDIN_ENABLED=1
# LINKEDIN_TELEGRAM_CHAT_ID=   # defaults to VINREPORT_USER_ID
# LINKEDIN_USER_DATA_DIR=      # default: ~/.linkedin-bot-chrome
# LINKEDIN_HEADLESS=0
# LINKEDIN_FOLLOW_PROBABILITY=0.7
# LINKEDIN_POST_MIN_DAYS=1
# LINKEDIN_POST_MAX_DAYS=5
